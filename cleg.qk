    fn render(ClegSpinBox self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        Rect c = clegstyle::contentRect(self);
        String t = clegstyle::getD(self, "text", clegstyle::stateOf(self), "");
        if (t == "") { t = self.value.toString(); }
        clegstyle::paintTextD(self, t, c.x, c.y, c.w - 24, c.h, "left", "middle");
        if (c.w > 24) {
            clegfx::blend(c.x + c.w - 18, c.y + 3, 14, c.h / 2 - 4, qss::mkColor(52, 130, 180, 255), 255, 2);
            clegfx::blend(c.x + c.w - 18, c.y + c.h / 2 + 1, 14, c.h / 2 - 4, qss::mkColor(52, 130, 180, 255), 255, 2);
        }
        clegstyle::end(tf);
