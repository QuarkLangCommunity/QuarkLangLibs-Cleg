struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
} ClegButton;

impl ClegButton ClegNode {
    fn new() ClegButton {
        s ClegButton;
        s.style = HashTable::new();
        s.style["text"] = "Button";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        // QSS 键优先：background-color / color / border-radius / font-size / font-family
        clegrt.cleg_roundrect(self.getX(), self.getY(), self.w, self.h,
            qss::num(self.style, "border-radius", 0),
            qss::cr(self.style, "background-color", 0, 56),
            qss::cr(self.style, "background-color", 1, 64),
            qss::cr(self.style, "background-color", 2, 84));
        clegrt.cleg_text(self.getX() + 16, self.getY() + 12, qss::num(self.style, "font-size", 4),
            qss::cr(self.style, "color", 0, 255),
            qss::cr(self.style, "color", 1, 255),
            qss::cr(self.style, "color", 2, 255),
            self.style.get("text"),
            qss::st(self.style, "font-family", "monospace"));
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setText(self, t String) void { self.style["text"] = t; }
    fn setStyle(self, jsonText String) void {
        obj HashTable<String, String> = json::loads(jsonText);
        ks List<String> = obj.keys();
        i int = 0;
        while (i < ks.size()) {
            k String = ks[i];
            self.style[k] = obj.get(k);
            i = i + 1;
        }
    }
} ClegButton;

