} ClegDial;

impl {
    fn new() ClegDial {
        ClegDial s;
        s.style = HashTable::new();
        s.style["__type"] = "ClegDial";
        s.style["__def~text"] = "Dial";
        s.style["__def~color"] = "255,255,255";
        s.style["__def~bg"] = "56,64,84";
        s.style["__def~size"] = "4";
        s.style["__def~font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["__def~items"] = "";
        s.style["__def~tabs"] = "";
        s.style["__def~menus"] = "";
        s.style["__def~rows"] = "3";
        s.x = 0; s.y = 0; s.w = 96; s.h = 96;
        return s;
    }
    fn render(ClegDial self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        Rect c = clegstyle::contentRect(self);
        int d = c.h;
        if (d > c.w) { d = c.w; }
        if (d > 0) {
            clegfx::blend(c.x + d / 4, c.y + d / 4, d / 2, d / 2, qss::mkColor(52, 211, 235, 255), 255, d / 4);
            clegfx::blend(c.x + d * 40 / 96, c.y + d / 16, d / 6, d / 8, qss::mkColor(240, 170, 60, 255), 255, 2);
        }
        clegstyle::end(tf);
    }
    fn getStyle(ClegDial self) HashTable<String, String> { return self.style; }
    fn getX(ClegDial self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegDial self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegDial self) int { return self.w; }
    fn getH(ClegDial self) int { return self.h; }
    fn setValue(ClegDial self, int v) void { self.value = v; } fn value(ClegDial self) int { return self.value; }
    fn setStyle(ClegDial self, String jsonText) void {
        clegstyle::setStyle(self, jsonText);
    }
} ClegDial;

