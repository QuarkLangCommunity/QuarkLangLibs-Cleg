        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        String st = clegstyle::stateOf(self);
        Rect c = clegstyle::contentRect(self);
        List<String> items = clegstyle::getD(self, "items", st, "").split(";");
        int i = 0;
        while (i < items.size()) {
            int ry = c.y + i * 28;
            clegfx::blend(c.x + 12, ry + 13, 10, 2, qss::mkColor(100, 110, 130, 255), 255, 0);
            clegstyle::paintTextD(self, items[i], c.x + 30, ry, c.w - 38, 28, "left", "middle");
            i = i + 1;
        }
        clegstyle::end(tf);
    }
    fn getStyle(ClegTreeWidget self) HashTable<String, String> { return self.style; }
    fn getX(ClegTreeWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegTreeWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegTreeWidget self) int { return self.w; }
    fn getH(ClegTreeWidget self) int { return self.h; }
    fn addTopLevelItem(ClegTreeWidget self, String t) void { self.style["items"] = clegstyle::getD(self, "items", clegstyle::stateOf(self), "") + ";" + t; }
