        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegDialogButtonBox self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegDialogButtonBox self) int { return self.w; }
    fn getH(ClegDialogButtonBox self) int { return self.h; }
    fn addButton(ClegDialogButtonBox self, String t) void { self.style["items"] = clegstyle::getD(self, "items", clegstyle::stateOf(self), "") + ";" + t; }
    fn setStyle(ClegDialogButtonBox self, String jsonText) void {
        clegstyle::setStyle(self, jsonText);
    }
} ClegDialogButtonBox;

type struct {
    HashTable<String, String> style;
    int x;
    int y;
    int w;
    int h;
} ClegOpenGLWidget;

impl {
    fn new() ClegOpenGLWidget {
        ClegOpenGLWidget s;
        s.style = HashTable::new();
        s.style["__type"] = "ClegOpenGLWidget";
        s.style["__def~text"] = "OpenGLWidget";
        s.style["__def~color"] = "255,255,255";
        s.style["__def~bg"] = "56,64,84";
        s.style["__def~size"] = "4";
        s.style["__def~font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["__def~items"] = "";
        s.style["__def~tabs"] = "";
        s.style["__def~menus"] = "";
        s.style["__def~rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(ClegOpenGLWidget self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        Rect c = clegstyle::contentRect(self);
        clegfx::blend(c.x + 8, c.y + 8, c.w - 16, c.h - 16, qss::mkColor(20, 28, 44, 255), 255, 2);
        clegstyle::paintTextD(self, "GPU SURFACE", c.x + 16, c.y + 16, c.w - 32, c.h - 32, "left", "top");
        clegstyle::end(tf);
    }
    fn getStyle(ClegOpenGLWidget self) HashTable<String, String> { return self.style; }
    fn getX(ClegOpenGLWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegOpenGLWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegOpenGLWidget self) int { return self.w; }
    fn getH(ClegOpenGLWidget self) int { return self.h; }
    fn setStyle(ClegOpenGLWidget self, String jsonText) void {
        clegstyle::setStyle(self, jsonText);
    }
} ClegOpenGLWidget;

