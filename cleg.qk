        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        qkcleg_text(self.getX(), self.getY(), self.style.get("size").toInt(),
        self.style.get("color").split(",")[0].toInt(),
        self.style.get("color").split(",")[1].toInt(),
        self.style.get("color").split(",")[2].toInt(),
        self.style.get("text"));
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setText(self, t String) void { self.style["text"] = t; }
    fn setStyle(self, jsonText String) void {
        qkcleg_style_parse(self.style, jsonText);
    }
} ClegLabel;

struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
} ClegButton;

impl ClegButton ClegNode {
    fn new() ClegButton {
        s ClegButton;
        s.style = HashTable::new();
        s.style["text"] = "Button";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        bg String = self.style.get("bg");
        qkcleg_rect(self.getX(), self.getY(), self.w, self.h,
        bg.split(",")[0].toInt(), bg.split(",")[1].toInt(), bg.split(",")[2].toInt());
        color String = self.style.get("color");
        qkcleg_text(self.getX() + 16, self.getY() + 12, 4,
        color.split(",")[0].toInt(), color.split(",")[1].toInt(), color.split(",")[2].toInt(),
        self.style.get("text"));
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setText(self, t String) void { self.style["text"] = t; }
    fn setStyle(self, jsonText String) void {
        qkcleg_style_parse(self.style, jsonText);
    }
} ClegButton;

struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
    checked bool;
} ClegCheckBox;

impl ClegCheckBox ClegNode {
    fn new() ClegCheckBox {
        s ClegCheckBox;
        s.style = HashTable::new();
        s.style["text"] = "CheckBox";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        qkcleg_rect(self.getX(), self.getY(), 36, 36, 120, 130, 150);
        if (self.checked) { qkcleg_rect(self.getX() + 8, self.getY() + 8, 20, 20, 52, 211, 235); }
        qkcleg_text(self.getX() + 48, self.getY() + 6, 4, 220, 225, 235, self.style.get("text"));
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setChecked(self, c bool) void { self.checked = c; } fn isChecked(self) bool { return self.checked; }
    fn setStyle(self, jsonText String) void {
        qkcleg_style_parse(self.style, jsonText);
    }
} ClegCheckBox;

