/* QuarkLang 官方库：cleg —— 全面 GUI 框架（Qt 组件全集 Cleg 化，官方认证）
 *
 * 设计：ClegNode 核心接口（dynamic 协议，结构化满足）；每个 Qt 组件均为 type struct + impl：
 *   ClegWindow/ClegDialog/ClegFrame/ClegGroupBox/ClegLabel/ClegButton/ClegCheckBox/
 *   ClegRadioButton/ClegLineEdit/ClegTextEdit/ClegPlainTextEdit/ClegTextBrowser/
 *   ClegProgressBar/ClegSlider/ClegScrollBar/ClegDial/ClegSpinBox/ClegDoubleSpinBox/
 *   ClegComboBox/ClegListWidget/ClegListView/ClegTableWidget/ClegTableView/
 *   ClegTreeWidget/ClegTreeView/ClegTabWidget/ClegStackedWidget/ClegToolBox/
 *   ClegMenuBar/ClegMenu/ClegToolBar/ClegStatusBar/ClegScrollArea/ClegSplitter/
 *   ClegDockWidget/ClegMdiArea/ClegMdiSubWindow/ClegCalendarWidget/ClegDateEdit/
 *   ClegTimeEdit/ClegLCDNumber/ClegHeaderView/ClegColumnView/ClegSizeGrip/
 *   ClegDialogButtonBox/ClegOpenGLWidget/ClegVideoWidget
 *
 * 全节点 Style(HashTable<String,String>) 驱动渲染；render/getStyle/getX/getY/getW/getH 协议。
 */
program library;

import "json";
import "style";

// ---------- cleg 渲染服务（native: libclegrt.so，纯 Go 零依赖跨系统） ----------
library clegrt {
    fn cleg_create(int w, int h) int;
    fn cleg_clear(int r, int g, int b) int;
    fn cleg_rect(int x, int y, int w, int h, int r, int g, int b) int;
    fn cleg_roundrect(int x, int y, int w, int h, int radius, int r, int g, int b) int;
    fn cleg_text(int x, int y, int size, int r, int g, int b, String text, String font) int;
    fn cleg_frame(String path) int;
    fn cleg_screen_open(int w, int h, String title) int;
    fn cleg_screen_present() int;
    fn cleg_screen_close() int;
    // ---- §9 Style v2 渲染原语（冻结签名，native 已实现） ----
    fn cleg_blend_rect(int x, int y, int w, int h, int argb, int alpha, int radius) int;
    fn cleg_gradient(int x, int y, int w, int h, int dir, int c1, int c2, int radius) int;
    fn cleg_radial(int cx, int cy, int r, int c1, int c2) int;
    fn cleg_border(int x, int y, int w, int h, int wt, int wr, int wb, int wl, int ct, int cr, int cb, int cl, int radius, int style) int;
    fn cleg_shadow(int x, int y, int w, int h, int dx, int dy, int blur, int spread, int argb, int inset, int radius) int;
    fn cleg_clip_push(int x, int y, int w, int h) int;
    fn cleg_clip_pop() int;
    fn cleg_text_width(String text, int size, String font) int;
    fn cleg_text_height(int size) int;
    fn cleg_text_ex(String text, int x, int y, int size, String font, int color, int align, int valign, int letter_spacing, int line_height, int decoration, int ellipsis, int max_w) int;
    fn cleg_image(String path, int x, int y, int w, int h, int repeat) int;
    fn cleg_transform(int dx, int dy, int sx_num, int sx_den, int sy_num, int sy_den) int;
}


// ---------- 自动重绘（纯 qk：tick 遍历节点列表逐个 render） ----------
fn tick(List<ClegNode> nodes) void {
    int i = 0;
    while (i < nodes.size()) {
        ClegNode n = nodes[i];
        n.render();
        i = i + 1;
    }
}

// ---------- 布局（Qt QBoxLayout 语义：按槽位重排节点 pos；读取 §5 gap/spacing） ----------
space {
    fn gapOf(ClegNode n, int fb) int {
        String st = clegstyle::stateOf(n);
        String g = clegstyle::getD(n, "gap", st, "");
        if (g == "") { g = clegstyle::getD(n, "spacing", st, ""); }
        if (g == "") { return fb; }
        return qss::len(g, fb);
    }
    fn vbox(List<ClegNode> items, int x, int y, int w, int spacing) void {
        int cur = y;
        int i = 0;
        while (i < items.size()) {
            ClegNode n = items[i];
            n.getStyle()["pos"] = x.toString() + "," + cur.toString();
            cur = cur + n.getH() + cleglayout::gapOf(n, spacing);
            i = i + 1;
        }
    }
    fn hbox(List<ClegNode> items, int x, int y, int spacing) void {
        int cur = x;
        int i = 0;
        while (i < items.size()) {
            ClegNode n = items[i];
            n.getStyle()["pos"] = cur.toString() + "," + y.toString();
            cur = cur + n.getW() + cleglayout::gapOf(n, spacing);
            i = i + 1;
        }
    }
    fn grid(List<ClegNode> items, int x, int y, int cols, int cw, int ch, int spacing) void {
        int i = 0;
        while (i < items.size()) {
            ClegNode n = items[i];
            int gx = x + (i % cols) * (cw + spacing);
            int gy = y + (i / cols) * (ch + spacing);
            n.getStyle()["pos"] = gx.toString() + "," + gy.toString();
            i = i + 1;
        }
    }
} cleglayout;

// ---------- 信号（Qt signal 语义 v1）+ 事件状态位（§6） ----------
space {
    fn emit(ClegNode node, String name) void {
        qksignal_emit(node, name);
    }
    // emit 带参：onTextChanged(newText) / onValueChanged(value) / onCurrentIndexChanged(index) 等
    fn emitArgs(ClegNode node, String name, int v) void {
        qksignal_emit(node, name, v);
    }
    fn emitText(ClegNode node, String name, String v) void {
        qksignal_emit(node, name, v);
    }
    // 事件 → 状态位（hover/pressed/focus/...）→ 再派发对应信号
    fn dispatchEvent(ClegNode node, String event, bool on) void {
        if (event == "enter" || event == "hover") { clegstyle::setState(node, "hover", on); }
        else if (event == "leave") { clegstyle::setState(node, "hover", false); clegstyle::setState(node, "pressed", false); }
        else if (event == "press" || event == "pressed") { clegstyle::setState(node, "pressed", on); clegstyle::setState(node, "active", on); }
        else if (event == "release") { clegstyle::setState(node, "pressed", false); }
        else if (event == "focus") { clegstyle::setState(node, "focus", on); }
        else if (event == "blur") { clegstyle::setState(node, "focus", false); }
        else if (event == "toggle") { clegstyle::setState(node, "checked", on); clegstyle::setState(node, "unchecked", !on); }
        else if (event == "select") { clegstyle::setState(node, "selected", on); }
        else if (event == "open") { clegstyle::setState(node, "open", on); }
        else if (event == "enable") {
            if (on) { node.getStyle()["enabled"] = "true"; } else { node.getStyle()["enabled"] = "false"; }
        }
        else { clegstyle::setState(node, event, on); }
        if (on) {
            if (event == "release") { clegsignal::emit(node, "clicked"); }
            else if (event == "toggle") { clegsignal::emit(node, "toggled"); }
            else if (event == "select") { clegsignal::emit(node, "currentIndexChanged"); }
        }
    }
} clegsignal;



type interface {
    dynamic fn render(Self self) void;
    dynamic fn setStyle(Self self, String jsonText) void;
    dynamic fn getStyle(Self self) HashTable<String, String>;
    dynamic fn getX(Self self) int;
    dynamic fn getY(Self self) int;
    dynamic fn getW(Self self) int;
    dynamic fn getH(Self self) int;
} ClegNode;

space {

    fn blend(int x, int y, int w, int h, int argb, int alpha, int radius) void {
        if (w <= 0 || h <= 0) { return; }
        clegrt.cleg_blend_rect(x, y, w, h, argb, alpha, radius);
    }
    fn gradient(int x, int y, int w, int h, int dir, int c1, int c2, int radius) void {
        if (w <= 0 || h <= 0) { return; }
        clegrt.cleg_gradient(x, y, w, h, dir, c1, c2, radius);
    }
    fn radial(int cx, int cy, int r, int c1, int c2) void {
        if (r <= 0) { return; }
        clegrt.cleg_radial(cx, cy, r, c1, c2);
    }
    fn border(int x, int y, int w, int h, int wt, int wr, int wb, int wl, int ct, int cr, int cb, int cl, int radius, int style) void {
        if (w <= 0 || h <= 0) { return; }
        if (wt <= 0 && wr <= 0 && wb <= 0 && wl <= 0) { return; }
        clegrt.cleg_border(x, y, w, h, wt, wr, wb, wl, ct, cr, cb, cl, radius, style);
    }
    fn shadow(int x, int y, int w, int h, int dx, int dy, int blur, int spread, int argb, int inset, int radius) void {
        if (w <= 0 || h <= 0) { return; }
        clegrt.cleg_shadow(x, y, w, h, dx, dy, blur, spread, argb, inset, radius);
    }
    fn clipPush(int x, int y, int w, int h) void { clegrt.cleg_clip_push(x, y, w, h); }
    fn clipPop() void { clegrt.cleg_clip_pop(); }
    fn textWidth(String text, int size, String font) int { return clegrt.cleg_text_width(text, size, font); }
    fn textHeight(int size) int { return clegrt.cleg_text_height(size); }
    fn textEx(String text, int x, int y, int size, String font, int color, int align, int valign, int ls, int lh, int deco, int ellipsis, int maxw) void {
        clegrt.cleg_text_ex(text, x, y, size, font, color, align, valign, ls, lh, deco, ellipsis, maxw);
    }
    fn image(String path, int x, int y, int w, int h, int repeat) void {
        if (path == "") { return; }
        clegrt.cleg_image(path, x, y, w, h, repeat);
    }
    // cleg_transform 是绝对设置（非级联、无 rotate）；调用方负责成对 reset
    fn transform(int dx, int dy, int sxn, int sxd, int syn, int syd) void {
        clegrt.cleg_transform(dx, dy, sxn, sxd, syn, syd);
    }
    fn transformReset() void { clegrt.cleg_transform(0, 0, 1000, 1000, 1000, 1000); }
} clegfx;

// ---------- clegstyle：cleg 对通用 style 库的绑定层（薄转发 + FFI 绘制 + 组件配方） ----------
// 通用能力（qss 值解析 / style 级联 / Theme / Animator）在 QuarkLangLibs-Style/style.qk（import "style"）；
// 本空间只保留 cleg 专属：ClegNode→StyleNode 桥、native 绘制原语调用、组件渲染配方。
// 对外 API（clegstyle::get/stateOf/contentRect/... 与 cleg::setState 等）保持与重构前一致。
space {

    // ===== §0/§1/§4/§5 通用求值：转发 style:: =====
    fn setState(ClegNode node, String name, bool on) void { style::setState(node, name, on); }
    fn hasState(ClegNode node, String name) bool { return style::hasState(node, name); }
    fn stateHas(String state, String one) bool { return style::stateHas(state, one); }
    fn stateOf(ClegNode node) String { return style::stateOf(node); }
    fn normalizeKey(String k) String { return style::normalizeKey(k); }
    fn setStyle(ClegNode node, String jsonText) void { style::setStyle(node, jsonText); }
    fn applyFontShorthand(ClegNode node, String v) void { style::applyFontShorthand(node, v); }
    fn get(ClegNode node, String key, String state) String { return style::get(node, key, state); }
    fn getBase(ClegNode node, String key, String state) String { return style::getBase(node, key, state); }
    fn getD(ClegNode node, String key, String state, String fb) String { return style::getD(node, key, state, fb); }
    fn getI(ClegNode node, String key, String state, int fb) int { return style::getI(node, key, state, fb); }
    fn getF(ClegNode node, String key, String state, float fb) float { return style::getF(node, key, state, fb); }
    fn getSub(ClegNode node, String key, String sub, String state) String { return style::getSub(node, key, sub, state); }
    fn subColor(ClegNode node, String key, String sub, String state, int dr, int dg, int db, int da) int { return style::subColor(node, key, sub, state, dr, dg, db, da); }
    fn opacity255(String v) int { return style::opacity255(v); }
    fn borderRect(ClegNode node) Rect { return style::borderRect(node); }
    fn contentRect(ClegNode node) Rect { return style::contentRect(node); }
    fn visible(ClegNode node) bool { return style::visible(node); }
    fn isClipped(ClegNode node, String st) bool { return style::isClipped(node, st); }
    fn borderStyle(ClegNode node, String st) int { return style::borderStyle(node, st); }
    fn radiusOf(ClegNode node, String st) int { return style::radiusOf(node, st); }
    fn borderColor(ClegNode node, String side, String st, int dr, int dg, int db) int { return style::borderColor(node, side, st, dr, dg, db); }
    fn isKeyword(String t) bool { return style::isKeyword(t); }
    // 全局层：由调用方持有的 Theme 写入（style::Theme）；低级入口保留
    fn globalTo(ClegNode node, String jsonText) void { style::globalTo(node, jsonText); }
    fn clearGlobal(ClegNode node) void { style::clearGlobal(node); }
    fn inherit(ClegNode child, ClegNode parent) void { style::inherit(child, parent); }

    // ===== §5 transform/clip 成对 begin/end（依赖 native 变换/裁剪，属 cleg 专属） =====
    // 返回位掩码：1=transform 生效，2=clip 生效（-1 = 不可见）
    fn begin(ClegNode node) int {
        if (!clegstyle::visible(node)) { return -1; }
        String st = clegstyle::stateOf(node);
        int flags = 0;
        String tf = clegstyle::getD(node, "transform", st, "");
        if (tf != "" && tf != "none") {
            StyleTransform t = qss::transform(tf);
            if (qss::hasTransform(t)) {
                clegfx::transform(t.dx, t.dy, t.sxn, t.sxd, t.syn, t.syd);
                flags = flags + 1;
            }
        }
        if (clegstyle::isClipped(node, st)) {
            Rect b = clegstyle::borderRect(node);
            clegfx::clipPush(b.x, b.y, b.w, b.h);
            flags = flags + 2;
        }
        return flags;
    }
    fn end(int flags) void {
        if (flags < 0) { return; }
        if (flags % 2 == 1) { clegfx::transformReset(); }
        if (flags >= 2) { clegfx::clipPop(); }
    }

    // ===== §8 组件渲染配方（盒模型 + 背景 + 边框 + 文本；cleg 专属） =====
    fn paintShadow(ClegNode node, int x, int y, int w, int h, String sh, int radius) void {
        List<String> layers = qss::splitTop(sh);
        int i = 0;
        while (i < layers.size()) {
            List<String> ts = qss::tokens(layers[i]);
            int dx = 0;
            int dy = 0;
            int blur = 0;
            int spread = 0;
            int col = qss::mkColor(0, 0, 0, 128);
            int inset = 0;
            int numsSeen = 0;
            int j = 0;
            while (j < ts.size()) {
                String t = ts[j];
                if (t == "inset") { inset = 1; }
                else if (t == "none") { }
                else if (qss::isColorStr(t) || t.startsWith("#") || t.startsWith("rgb")) { col = qss::color(t); }
                else {
                    int v = qss::len(t, 0);
                    if (numsSeen == 0) { dx = v; }
                    else if (numsSeen == 1) { dy = v; }
                    else if (numsSeen == 2) { blur = v; }
                    else if (numsSeen == 3) { spread = v; }
                    numsSeen = numsSeen + 1;
                }
                j = j + 1;
            }
            clegfx::shadow(x, y, w, h, dx, dy, blur, spread, col, inset, radius);
            i = i + 1;
        }
    }
    fn paintBox(ClegNode node) void {
        Rect b = clegstyle::borderRect(node);
        clegstyle::paintBoxAt(node, b.x, b.y, b.w, b.h);
    }
    fn paintBoxAt(ClegNode node, int bx, int by, int bw, int bh) void {
        if (bw <= 0 || bh <= 0) { return; }
        if (!clegstyle::visible(node)) { return; }
        String st = clegstyle::stateOf(node);
        int opacity = clegstyle::opacity255(clegstyle::getD(node, "opacity", st, "1"));
        int radius = clegstyle::radiusOf(node, st);
        String sh = clegstyle::getD(node, "box-shadow", st, "");
        if (sh != "") { clegstyle::paintShadow(node, bx, by, bw, bh, sh, radius); }
        String gr = clegstyle::getD(node, "background-gradient", st, "");
        if (gr != "") {
            StyleGradient g = qss::gradient(gr);
            if (g.kind == 1) {
                clegfx::gradient(bx, by, bw, bh, qss::gradDir(g.angle), g.c1, g.c2, radius);
            } else if (g.kind == 2) {
                int cx = bx + bw * g.cx / 100;
                int cy = by + bh * g.cy / 100;
                int rr = bw * g.r / 200;
                clegfx::radial(cx, cy, rr, g.c1, g.c2);
            }
        } else {
            String bgv = clegstyle::getD(node, "background-color", st, "");
            if (bgv != "") {
                int argb = qss::color(bgv);
                int alpha = qss::cA(argb) * opacity / 255;
                int solid = qss::mkColor(qss::cR(argb), qss::cG(argb), qss::cB(argb), 255);
                clegfx::blend(bx, by, bw, bh, solid, alpha, radius);
            }
        }
        String img = clegstyle::getD(node, "background-image", st, "");
        if (img != "") {
            int rep = 0;
            String rs = clegstyle::getD(node, "background-repeat", st, "no-repeat");
            if (rs == "repeat") { rep = 1; }
            else if (rs == "repeat-x") { rep = 2; }
            else if (rs == "repeat-y") { rep = 3; }
            List<int> bp = qss::box4(clegstyle::getD(node, "background-position", st, "0"));
            clegfx::image(img, bx + bp[3], by + bp[0], bw, bh, rep);
        }
        List<int> bwl = qss::box4(clegstyle::getD(node, "border-width", st, "0"));
        if (bwl[0] != 0 || bwl[1] != 0 || bwl[2] != 0 || bwl[3] != 0) {
            int ct = clegstyle::borderColor(node, "top", st, 255, 255, 255);
            int cr = clegstyle::borderColor(node, "right", st, 255, 255, 255);
            int cb = clegstyle::borderColor(node, "bottom", st, 255, 255, 255);
            int cl = clegstyle::borderColor(node, "left", st, 255, 255, 255);
            clegfx::border(bx, by, bw, bh, bwl[0], bwl[1], bwl[2], bwl[3], ct, cr, cb, cl, radius, clegstyle::borderStyle(node, st));
        }
        if (clegstyle::stateHas(st, "focus")) {
            String ow = clegstyle::getD(node, "outline-width", st, "");
            if (ow != "") {
                List<int> owl = qss::box4(ow);
                int oc = qss::color(clegstyle::getD(node, "outline-color", st, "52,211,235"));
                clegfx::border(bx - owl[3], by - owl[0], bw + owl[1] + owl[3], bh + owl[0] + owl[2],
                    owl[0], owl[1], owl[2], owl[3], oc, oc, oc, oc, 0, 0);
            }
        }
    }

    // ===== §4 文本 =====
    fn alignOf(String v) int {
        String s = v.trim().toLower();
        if (s == "center") { return 1; }
        if (s == "right") { return 2; }
        return 0;
    }
    fn valignOf(String v) int {
        String s = v.trim().toLower();
        if (s == "middle" || s == "center") { return 1; }
        if (s == "bottom") { return 2; }
        return 0;
    }
    fn decoOf(String v) int {
        String s = v.trim().toLower();
        if (s == "underline") { return 1; }
        if (s == "line-through") { return 2; }
        return 0;
    }
    fn maskText(String t, String ch) String {
        String c = ch;
        if (c == "") { c = "*"; }
        String out = "";
        int i = 0;
        while (i < t.size()) { out = out + c; i = i + 1; }
        return out;
    }
    fn paintTextD(ClegNode node, String text, int x, int y, int w, int h, String dAlign, String dValign) void {
        clegstyle::paintTextC(node, text, x, y, w, h, dAlign, dValign, "");
    }
    fn paintTextC(ClegNode node, String text, int x, int y, int w, int h, String dAlign, String dValign, String colorOverride) void {
        if (text == "") { return; }
        String st = clegstyle::stateOf(node);
        int size = qss::fontSize(clegstyle::getD(node, "font-size", st, "9"));
        String font = clegstyle::getD(node, "font-family", st, "monospace");
        if (font == "") { font = "monospace"; }
        int col = qss::color(clegstyle::getD(node, "color", st, "255,255,255"));
        if (colorOverride != "") { col = qss::color(colorOverride); }
        int align = clegstyle::alignOf(clegstyle::getD(node, "text-align", st, dAlign));
        int valign = clegstyle::valignOf(clegstyle::getD(node, "text-valign", st, dValign));
        int deco = clegstyle::decoOf(clegstyle::getD(node, "text-decoration", st, "none"));
        int ell = 0;
        if (clegstyle::getD(node, "text-overflow", st, "clip") == "ellipsis") { ell = 1; }
        int ls = qss::len(clegstyle::getD(node, "letter-spacing", st, "0"), 0);
        int lh = qss::lineHeightPx(clegstyle::getD(node, "line-height", st, ""), size);
        if (lh <= 0) { lh = size + 4; }
        // §9.1 锚点：native 的 x 是「参照盒左界」（align 1/2 在 [x, x+max_w] 内居中/右对齐），
        // y 是锚点（valign 1/2 = 盒垂直中心/盒底）。因此水平一律传「内容盒左界 + max_w=内容盒宽」，
        // 不再自行平移 x（旧实现自加 w/2 与 native 的居中叠加 → 文字右溢出胶囊）。
        int maxW = w;
        int ax = x;
        if (w <= 0 && align != 0) {
            int tw = clegfx::textWidth(text, size, font);
            if (align == 1) { ax = x - tw / 2; }
            if (align == 2) { ax = x - tw; }
        }
        // 垂直：以内容盒为参照（h<=0 时退化为单行行高盒）；文字 y 与 padding/border/圆角无关（内容盒已扣除）
        int boxH = h;
        if (boxH <= 0) { boxH = size + 4; }
        int ay = y;
        if (valign == 1) { ay = y + boxH / 2; }
        if (valign == 2) { ay = y + boxH; }
        clegfx::textEx(text, ax, ay, size, font, col, align, valign, ls, lh, deco, ell, maxW);
    }
    fn paintText(ClegNode node, String text, int x, int y, int w, int h) void {
        clegstyle::paintTextD(node, text, x, y, w, h, "left", "top");
    }
    fn paintTitle(ClegNode node) void {
        String st = clegstyle::stateOf(node);
        String t = clegstyle::getD(node, "title", st, "");
        if (t == "") { t = clegstyle::getD(node, "text", st, ""); }
        Rect c = clegstyle::contentRect(node);
        clegstyle::paintTextD(node, t, c.x, c.y, c.w, c.h, "left", "middle");
    }
    fn paintLines(ClegNode node, String text, int maxLines) void {
        List<String> lines = text.split("\n");
        String st = clegstyle::stateOf(node);
        int size = qss::fontSize(clegstyle::getD(node, "font-size", st, "9"));
        int lh = qss::lineHeightPx(clegstyle::getD(node, "line-height", st, ""), size);
        if (lh <= 0) { lh = size + 4; }
        Rect c = clegstyle::contentRect(node);
        int i = 0;
        while (i < lines.size() && i < maxLines) {
            clegstyle::paintTextD(node, lines[i], c.x, c.y + i * lh, c.w, lh, "left", "top");
            i = i + 1;
        }
    }
    // ===== §8 组件渲染配方（各组件 render 统一入口：盒模型 + 背景 + 边框 + 文本） =====
    fn label(ClegNode node) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        clegstyle::paintText(node, clegstyle::getD(node, "text", st, ""), c.x, c.y, c.w, c.h);
        clegstyle::end(tf);
    }
    fn button(ClegNode node) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        clegstyle::paintTextD(node, clegstyle::getD(node, "text", st, ""), c.x, c.y, c.w, c.h, "center", "middle");
        clegstyle::end(tf);
    }
    fn field(ClegNode node) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        String t = clegstyle::getD(node, "text", st, "");
        if (t == "") {
            String ph = clegstyle::getD(node, "placeholder", st, "");
            if (ph != "") {
                String pc = clegstyle::getD(node, "placeholder-text-color", st, "130,140,160");
                clegstyle::paintTextC(node, ph, c.x, c.y, c.w, c.h, "left", "middle", pc);
            }
            clegstyle::end(tf);
            return;
        }
        if (clegstyle::getD(node, "echo-mode", st, "normal") == "password") {
            t = clegstyle::maskText(t, clegstyle::getD(node, "password-char", st, "*"));
        }
        clegstyle::paintTextD(node, t, c.x, c.y, c.w, c.h, "left", "middle");
        clegstyle::end(tf);
    }
    fn lines(ClegNode node, int maxLines) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        String t = clegstyle::getD(node, "text", st, "");
        Rect c = clegstyle::contentRect(node);
        if (clegstyle::getD(node, "white-space", st, "normal") == "nowrap") {
            clegstyle::paintTextD(node, t.replace("\n", " "), c.x, c.y, c.w, c.h, "left", "top");
        } else {
            clegstyle::paintLines(node, t, maxLines);
        }
        clegstyle::end(tf);
    }
    fn progress(ClegNode node, int value, int vmax, String text) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        int v = value;
        if (vmax <= 0) { vmax = 100; }
        if (v < 0) { v = 0; }
        if (v > vmax) { v = vmax; }
        int cw = c.w * v / vmax;
        String cg = clegstyle::getSub(node, "background-gradient", "chunk", st);
        int cradius = qss::len(clegstyle::getSub(node, "border-radius", "chunk", st), 0);
        if (cw > 0) {
            if (cg != "") {
                StyleGradient g = qss::gradient(cg);
                if (g.kind == 1) { clegfx::gradient(c.x, c.y, cw, c.h, qss::gradDir(g.angle), g.c1, g.c2, cradius); }
                else if (g.kind == 2) { clegfx::radial(c.x + cw / 2, c.y + c.h / 2, cw / 2, g.c1, g.c2); }
                else { clegfx::blend(c.x, c.y, cw, c.h, g.c1, 255, cradius); }
            } else {
                int cc = clegstyle::subColor(node, "background-color", "chunk", st, 52, 211, 235, 255);
                int ca = qss::cA(cc) * clegstyle::opacity255(clegstyle::getD(node, "opacity", st, "1")) / 255;
                clegfx::blend(c.x, c.y, cw, c.h, qss::mkColor(qss::cR(cc), qss::cG(cc), qss::cB(cc), 255), ca, cradius);
            }
        }
        clegstyle::paintTextD(node, text, c.x, c.y, c.w, c.h, "center", "middle");
        clegstyle::end(tf);
    }
    fn slider(ClegNode node, int value, int vmax) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        int v = value;
        if (vmax <= 0) { vmax = 100; }
        if (v < 0) { v = 0; }
        if (v > vmax) { v = vmax; }
        int gh = qss::len(clegstyle::getSub(node, "height", "groove", st), 6);
        if (gh > c.h) { gh = c.h; }
        int gy = c.y + c.h / 2 - gh / 2;
        int gc = clegstyle::subColor(node, "background-color", "groove", st, 90, 100, 120, 255);
        int grad = qss::len(clegstyle::getSub(node, "border-radius", "groove", st), gh / 2);
        clegfx::blend(c.x, gy, c.w, gh, qss::mkColor(qss::cR(gc), qss::cG(gc), qss::cB(gc), 255), 255, grad);
        int hw = qss::len(clegstyle::getSub(node, "width", "handle", st), 24);
        int hh = qss::len(clegstyle::getSub(node, "height", "handle", st), c.h);
        if (hh > c.h) { hh = c.h; }
        if (hw > c.w) { hw = c.w; }
        if (hw < 1) { hw = 1; }
        int hx = c.x + (c.w - hw) * v / vmax;
        int hy = c.y + c.h / 2 - hh / 2;
        int hc = clegstyle::subColor(node, "background-color", "handle", st, 52, 211, 235, 255);
        int hradius = qss::len(clegstyle::getSub(node, "border-radius", "handle", st), hh / 2);
        clegfx::blend(hx, hy, hw, hh, qss::mkColor(qss::cR(hc), qss::cG(hc), qss::cB(hc), 255), 255, hradius);
        clegstyle::end(tf);
    }
    fn indicator(ClegNode node, bool checked, bool radio) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        int size = qss::len(clegstyle::getSub(node, "width", "indicator", st), 18);
        if (size > c.h) { size = c.h; }
        if (size < 1) { size = 1; }
        int ix = c.x;
        int iy = c.y + c.h / 2 - size / 2;
        int bg = clegstyle::subColor(node, "background-color", "indicator", st, 120, 130, 150, 255);
        int radius = size / 2;
        if (!radio) { radius = qss::len(clegstyle::getSub(node, "border-radius", "indicator", st), 3); }
        clegfx::blend(ix, iy, size, size, qss::mkColor(qss::cR(bg), qss::cG(bg), qss::cB(bg), 255), 255, radius);
        if (checked) {
            int fg = clegstyle::subColor(node, "color", "indicator", st, 52, 211, 235, 255);
            int m = size / 4;
            int iw = size - 2 * m;
            int iradius = 2;
            if (radio) { iradius = iw / 2; }
            clegfx::blend(ix + m, iy + m, iw, iw, qss::mkColor(qss::cR(fg), qss::cG(fg), qss::cB(fg), 255), 255, iradius);
        }
        String t = clegstyle::getD(node, "text", st, "");
        clegstyle::paintTextD(node, t, c.x + size + 8, c.y, c.w - size - 8, c.h, "left", "middle");
        clegstyle::end(tf);
    }
    fn clearScreen(ClegNode node) void {
        String st = clegstyle::stateOf(node);
        String bgv = clegstyle::getD(node, "background-color", st, "");
        if (bgv != "") {
            int c = qss::color(bgv);
            clegrt.cleg_clear(qss::cR(c), qss::cG(c), qss::cB(c));
        }
    }
    fn checkbox(ClegNode node, bool checked) void {
        clegstyle::setState(node, "checked", checked);
        clegstyle::setState(node, "unchecked", !checked);
        clegstyle::indicator(node, checked, false);
    }
    fn radiobutton(ClegNode node, bool checked) void {
        clegstyle::setState(node, "checked", checked);
        clegstyle::setState(node, "unchecked", !checked);
        clegstyle::indicator(node, checked, true);
    }
    fn listPaint(ClegNode node, List<String> items, int current, int rowH) void {
        // 数据类通用：背景 + 交替行 + 选中行 + 行文本（§8 第 5 组基础版）
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        int i = 0;
        while (i < items.size()) {
            int ry = c.y + i * rowH;
            if (i == current) {
                clegstyle::setState(node, "selected", true);
                String sst = clegstyle::stateOf(node);
                String sc = clegstyle::getD(node, "selection-background-color", sst, "52,130,180");
                int scol = qss::color(sc);
                clegfx::blend(c.x, ry, c.w, rowH, qss::mkColor(qss::cR(scol), qss::cG(scol), qss::cB(scol), 255), 255, 0);
                clegstyle::setState(node, "selected", false);
                String tc = clegstyle::getD(node, "selection-color", st, "20,26,38");
                clegstyle::paintTextC(node, items[i], c.x + 8, ry, c.w - 16, rowH, "left", "middle", tc);
            } else {
                if (clegstyle::getD(node, "alternate-background-color", st, "") != "" && i % 2 == 1) {
                    int ac = qss::color(clegstyle::getD(node, "alternate-background-color", st, ""));
                    clegfx::blend(c.x, ry, c.w, rowH, qss::mkColor(qss::cR(ac), qss::cG(ac), qss::cB(ac), 255), 255, 0);
                }
                clegstyle::paintTextD(node, items[i], c.x + 8, ry, c.w - 16, rowH, "left", "middle");
            }
            i = i + 1;
        }
        clegstyle::end(tf);
    }
    fn gridPaint(ClegNode node, int rows, String rowPrefix, int rowH) void {
        int tf = clegstyle::begin(node);
        clegstyle::paintBox(node);
        String st = clegstyle::stateOf(node);
        Rect c = clegstyle::contentRect(node);
        String gc = clegstyle::getSub(node, "background-color", "gridline", st);
        if (gc == "") { gc = clegstyle::getD(node, "gridline-color", st, "170,178,190"); }
        int gcol = qss::color(gc);
        int i = 0;
        while (i < rows) {
            int ry = c.y + i * rowH;
            clegfx::blend(c.x, ry, c.w, 1, qss::mkColor(qss::cR(gcol), qss::cG(gcol), qss::cB(gcol), 255), 255, 0);
            String t = clegstyle::getD(node, rowPrefix + i.toString(), st, "");
            clegstyle::paintTextD(node, t, c.x + 8, ry, c.w - 16, rowH, "left", "middle");
            i = i + 1;
        }
        clegstyle::end(tf);
    }
} clegstyle;


type struct {
    HashTable<String, String> style;
    int x;
    int y;
    int w;
    int h;
} ClegMainWindow;

impl {
    fn new() ClegMainWindow {
        ClegMainWindow s;
        s.style = HashTable::new();
        s.style["__type"] = "ClegMainWindow";
        s.style["__def~text"] = "MainWindow";
        s.style["__def~color"] = "255,255,255";
        s.style["__def~bg"] = "56,64,84";
        s.style["__def~size"] = "4";
        s.style["__def~font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["__def~items"] = "";
        s.style["__def~tabs"] = "";
        s.style["__def~menus"] = "";
        s.style["__def~rows"] = "3";
        s.x = 0; s.y = 0; s.w = 1152; s.h = 704;
        return s;
    }
    fn render(ClegMainWindow self) void {
        if (!clegstyle::visible(self)) { return; }
        clegstyle::clearScreen(self);
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        clegstyle::paintTitle(self);
        clegstyle::end(tf);
    }
    fn getStyle(ClegMainWindow self) HashTable<String, String> { return self.style; }
    fn getX(ClegMainWindow self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegMainWindow self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegMainWindow self) int { return self.w; }
    fn getH(ClegMainWindow self) int { return self.h; }
    fn setTitle(ClegMainWindow self, String t) void { self.style["title"] = t; }
    fn setStyle(ClegMainWindow self, String jsonText) void {
        clegstyle::setStyle(self, jsonText);
    }
} ClegMainWindow;

