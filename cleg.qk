// ---------- 顶层驱动 + Style v2 API ----------

// ---------- ClegAnimator：style::Animator 的 cleg 薄封装（关键帧/transition 状态在 style::Animator 实例内）
// 保留旧 API：new/define/hasDef/tick(List<ClegNode>)/tickNode(ClegNode)/progress/allProps/transitionsOf
type struct {
    Animator core;
} ClegAnimator;

impl {
    fn new() ClegAnimator {
        ClegAnimator a;
        a.core = Animator::new();
        return a;
    }
    fn coreOf(ClegAnimator self) Animator { return self.core; }
    fn define(ClegAnimator self, String name, String json) void { self.core.define(name, json); }
    fn hasDef(ClegAnimator self, String name) bool { return self.core.hasDef(name); }
    // List<ClegNode> → List<StyleNode>：逐元素经 interface{} 桥接（接口→接口静态不可直传）
    fn tick(ClegAnimator self, List<ClegNode> nodes, int dtMs) void {
        List<StyleNode> sn = List::new();
        int i = 0;
        while (i < nodes.size()) {
            interface{} x = nodes[i];
            sn.append(x);
            i = i + 1;
        }
        self.core.tick(sn, dtMs);
    }
    fn tickNode(ClegAnimator self, ClegNode node, int dtMs) void {
        interface{} x = node;
        self.core.tickNode(x, dtMs);
    }
    fn progress(ClegAnimator self, int el, int dur, int delay, String count, String dir) float {
        return self.core.progress(el, dur, delay, count, dir);
    }
    fn allProps() List<String> { return Animator::allProps(); }
    fn transitionsOf(ClegAnimator self, ClegNode node, String st) List<String> {
        interface{} x = node;
        return self.core.transitionsOf(x, st);
    }
} ClegAnimator;

space {
    fn init(int w, int h) void { clegrt.cleg_create(w, h); }
    fn cleg_frame(String path) void { clegrt.cleg_frame(path); }
    // 跨系统屏幕宿主：Linux=X11 / Windows=GDI / 其它=帧输出回退
    fn show(int w, int h, String title) void {
        clegrt.cleg_create(w, h);
        clegrt.cleg_screen_open(w, h, title);
    }
    fn present() void { clegrt.cleg_screen_present(); }
    fn hide() void { clegrt.cleg_screen_close(); }
    // ---- Style v2 状态 / 全局样式 / 子件绘制 ----
    fn setState(ClegNode node, String name, bool on) void { clegstyle::setState(node, name, on); }
    fn stateOf(ClegNode node) String { return clegstyle::stateOf(node); }
    // 主题（实例化全局层，替代旧的 setGlobalStyle/clearGlobalStyle 文件方案）：
    //   Theme t = cleg::theme("{...}");  t.applyAny(node) / cleg::applyTheme(t, node) / cleg::getThemed(t, node, key, state)
    fn theme(String jsonText) Theme { return Theme::fromJson(jsonText); }
    fn emptyTheme() Theme { return Theme::new(); }
    fn applyTheme(Theme t, ClegNode node) void { t.applyAny(node); }
    fn getThemed(Theme t, ClegNode node, String key, String state) String { interface{} x = node; return style::getThemed(t, x, key, state); }
    fn clearTheme(ClegNode node) void { clegstyle::clearGlobal(node); }
    fn refreshStyle(ClegNode node) void { clegstyle::clearGlobal(node); }
    fn inherit(ClegNode child, ClegNode parent) void { clegstyle::inherit(child, parent); }
    fn setStyle(ClegNode node, String jsonText) void { clegstyle::setStyle(node, jsonText); }
    fn get(ClegNode node, String key, String state) String { return clegstyle::get(node, key, state); }
    fn contentRect(ClegNode node) Rect { return clegstyle::contentRect(node); }
    fn clipPush(int x, int y, int w, int h) void { clegfx::clipPush(x, y, w, h); }
    fn clipPop() void { clegfx::clipPop(); }
} cleg;