struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
    value int;
} ClegProgressBar;

impl ClegProgressBar ClegNode {
    fn new() ClegProgressBar {
        s ClegProgressBar;
        s.style = HashTable::new();
        s.style["text"] = "ProgressBar";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        qkcleg_rect(self.getX(), self.getY(), self.w, self.h, 60, 66, 82);
        qkcleg_rect(self.getX(), self.getY(), self.w * self.value / 100, self.h, 52, 211, 235);
        qkcleg_text(self.getX() + self.w / 2 - 24, self.getY() + 6, 3, 255, 255, 255, self.value.toString());
