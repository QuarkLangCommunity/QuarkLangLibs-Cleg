impl ClegLabel ClegNode {
    fn new() ClegLabel {
        s ClegLabel;
        s.style = HashTable::new();
        s.style["text"] = "Label";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
