struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
    current int;
} ClegColumnView;

impl ClegColumnView ClegNode {
    fn new() ClegColumnView {
        s ClegColumnView;
        s.style = HashTable::new();
        s.style["text"] = "ColumnView";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        qkcleg_rect(self.getX(), self.getY(), self.w, self.h, 240, 245, 252);
        items List<String> = self.style.get("items").split(";");
        i int = 0;
        while (i < items.size()) {
        if (i == self.current) { qkcleg_rect(self.getX(), self.getY() + i * 28, self.w, 28, 52, 130, 180); }
        qkcleg_text(self.getX() + 8, self.getY() + i * 28 + 6, 4, 20, 26, 38, items[i]);
        i = i + 1;
        }
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setStyle(self, jsonText String) void {
        qkcleg_style_parse(self.style, jsonText);
    }
} ClegColumnView;

