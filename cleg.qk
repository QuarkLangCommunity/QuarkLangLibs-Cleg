        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(ClegComboBox self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        String st = clegstyle::stateOf(self);
        Rect c = clegstyle::contentRect(self);
        List<String> items = clegstyle::getD(self, "items", st, "").split(";");
        String t = "";
        if (self.current >= 0 && self.current < items.size()) { t = items[self.current]; }
        clegstyle::paintTextD(self, t, c.x, c.y, c.w - 30, c.h, "left", "middle");
        if (c.w > 30) { clegfx::blend(c.x + c.w - 26, c.y + 2, 24, c.h - 4, qss::mkColor(52, 130, 180, 255), 255, 3); }
        clegstyle::end(tf);
    }
