    fn render(ClegTabWidget self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        String st = clegstyle::stateOf(self);
        Rect c = clegstyle::contentRect(self);
        List<String> tabs = clegstyle::getD(self, "tabs", st, "").split(";");
        int i = 0;
        while (i < tabs.size()) {
            int tx = c.x + i * 128;
            if (i == self.current) { clegfx::blend(tx, c.y, 124, 40, qss::mkColor(52, 130, 180, 255), 255, 4); }
            else { clegfx::blend(tx, c.y, 124, 40, qss::mkColor(200, 205, 215, 255), 255, 4); }
            clegstyle::paintTextD(self, tabs[i], tx + 8, c.y, 108, 40, "center", "middle");
            i = i + 1;
        }
        clegfx::blend(c.x, c.y + 40, c.w, 2, qss::mkColor(170, 178, 190, 255), 255, 0);
        clegstyle::end(tf);
    }
    fn getStyle(ClegTabWidget self) HashTable<String, String> { return self.style; }
    fn getX(ClegTabWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegTabWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegTabWidget self) int { return self.w; }
    fn getH(ClegTabWidget self) int { return self.h; }
    fn addTab(ClegTabWidget self, String t) void { self.style["tabs"] = clegstyle::getD(self, "tabs", clegstyle::stateOf(self), "") + ";" + t; }
    fn setStyle(ClegTabWidget self, String jsonText) void {
