    fn getX(ClegComboBox self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegComboBox self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegComboBox self) int { return self.w; }
    fn getH(ClegComboBox self) int { return self.h; }
