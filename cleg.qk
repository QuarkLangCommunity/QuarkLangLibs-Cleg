// ---------- 顶层驱动 ----------
space {
    fn init(w int, h int) void { clegrt.cleg_create(w, h); }
    fn cleg_frame(path String) void { clegrt.cleg_frame(path); }
    // 跨系统屏幕宿主：Linux=X11 / Windows=GDI / 其它=帧输出回退
    fn show(w int, h int, title String) void {
        clegrt.cleg_create(w, h);
        clegrt.cleg_screen_open(w, h, title);
    }
    fn present() void { clegrt.cleg_screen_present(); }
    fn hide() void { clegrt.cleg_screen_close(); }
} (cleg);
