impl {
    fn new() ClegButton {
        ClegButton s;
        s.style = HashTable::new();
        s.style["__type"] = "ClegButton";
        s.style["__def~text"] = "Button";
        s.style["__def~color"] = "255,255,255";
        s.style["__def~bg"] = "56,64,84";
        s.style["__def~size"] = "4";
        s.style["__def~font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["__def~items"] = "";
        s.style["__def~tabs"] = "";
        s.style["__def~menus"] = "";
        s.style["__def~rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(ClegButton self) void {
