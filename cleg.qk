type struct {
    HashTable<String, String> style;
    int x;
    int y;
    int w;
    int h;
    int selected;
} ClegCalendarWidget;

impl {
    fn new() ClegCalendarWidget {
        ClegCalendarWidget s;
        s.style = HashTable::new();
        s.style["__type"] = "ClegCalendarWidget";
        s.style["__def~text"] = "CalendarWidget";
        s.style["__def~color"] = "255,255,255";
        s.style["__def~bg"] = "56,64,84";
        s.style["__def~size"] = "4";
        s.style["__def~font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["__def~items"] = "";
        s.style["__def~tabs"] = "";
        s.style["__def~menus"] = "";
        s.style["__def~rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(ClegCalendarWidget self) void {
        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        Rect c = clegstyle::contentRect(self);
        List<String> days = "SUN,MON,TUE,WED,THU,FRI,SAT".split(",");
        int i = 0;
        while (i < 7) {
            clegstyle::paintTextD(self, days[i], c.x + 8 + i * 44, c.y + 2, 40, 20, "center", "middle");
            i = i + 1;
        }
        int j = 1;
        while (j < 32) {
            int gx = c.x + 8 + (j - 1) % 7 * 44;
            int gy = c.y + 30 + (j - 1) / 7 * 36;
            clegfx::blend(gx, gy, 36, 28, qss::mkColor(200, 208, 220, 255), 255, 3);
            clegstyle::paintTextD(self, j.toString(), gx, gy, 36, 28, "center", "middle");
            j = j + 1;
        }
        clegstyle::end(tf);
    }
    fn getStyle(ClegCalendarWidget self) HashTable<String, String> { return self.style; }
    fn getX(ClegCalendarWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.x; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.x; }
        return p[0].toInt();
    }
    fn getY(ClegCalendarWidget self) int {
        String pos = clegstyle::get(self, "pos", clegstyle::stateOf(self));
        if (pos == "") { return self.y; }
        List<String> p = pos.split(",");
        if (p.size() < 2) { return self.y; }
        return p[1].toInt();
    }
    fn getW(ClegCalendarWidget self) int { return self.w; }
    fn getH(ClegCalendarWidget self) int { return self.h; }
    fn setSelectedDate(ClegCalendarWidget self, int d) void { self.selected = d; }
    fn setStyle(ClegCalendarWidget self, String jsonText) void {
        clegstyle::setStyle(self, jsonText);
    }
} ClegCalendarWidget;

