        clegrt.cleg_rect(self.getX(), self.getY(), self.w, self.h, 240, 245, 252);
        items List<String> = self.style.get("items").split(";");
        i int = 0;
        while (i < items.size()) {
        if (i == self.current) {
            clegrt.cleg_rect(self.getX(), self.getY() + i * 28, self.w, 28,
                qss::cr(self.style, "selection-background-color", 0, 52),
