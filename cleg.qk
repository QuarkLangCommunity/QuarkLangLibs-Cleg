        clegrt.cleg_rect(self.getX(), self.getY(), self.w, self.h, 240, 245, 252);
        items List<String> = self.style.get("items").split(";");
        i int = 0;
        while (i < items.size()) {
        if (i == self.current) { clegrt.cleg_rect(self.getX(), self.getY() + i * 28, self.w, 28, 52, 130, 180); }
        clegrt.cleg_text(self.getX() + 8, self.getY() + i * 28 + 6, 4, 20, 26, 38, items[i], qss::st(self.style, "font-family", "monospace"));
        i = i + 1;
        }
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setStyle(self, jsonText String) void {
        obj HashTable<String, String> = json::loads(jsonText);
        ks List<String> = obj.keys();
        i int = 0;
        while (i < ks.size()) {
            k String = ks[i];
            self.style[k] = obj.get(k);
            i = i + 1;
        }
    }
} ClegColumnView;

