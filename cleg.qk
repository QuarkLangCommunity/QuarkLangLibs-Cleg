/* QuarkLang 官方库：cleg —— 全面 GUI 框架（Qt 组件全集 Cleg 化，官方认证）
 *
 * 设计：ClegNode 核心接口（dynamic 协议）；每个 Qt 组件均为 struct + impl：
 *   ClegWindow/ClegDialog/ClegFrame/ClegGroupBox/ClegLabel/ClegButton/ClegCheckBox/
 *   ClegRadioButton/ClegLineEdit/ClegTextEdit/ClegPlainTextEdit/ClegTextBrowser/
 *   ClegProgressBar/ClegSlider/ClegScrollBar/ClegDial/ClegSpinBox/ClegDoubleSpinBox/
 *   ClegComboBox/ClegListWidget/ClegListView/ClegTableWidget/ClegTableView/
 *   ClegTreeWidget/ClegTreeView/ClegTabWidget/ClegStackedWidget/ClegToolBox/
 *   ClegMenuBar/ClegMenu/ClegToolBar/ClegStatusBar/ClegScrollArea/ClegSplitter/
 *   ClegDockWidget/ClegMdiArea/ClegMdiSubWindow/ClegCalendarWidget/ClegDateEdit/
 *   ClegTimeEdit/ClegLCDNumber/ClegHeaderView/ClegColumnView/ClegSizeGrip/
 *   ClegDialogButtonBox/ClegOpenGLWidget/ClegVideoWidget
 *
 * 全节点 Style(HashTable<String,String>) 驱动渲染；render/getStyle/getX/getY/getW/getH 协议。
 */
program library;

import "json";

// ---------- cleg 渲染服务（native: libclegrt.so，纯 Go 零依赖跨系统） ----------
library clegrt {
    fn cleg_create(w int, h int) int;
    fn cleg_clear(r int, g int, b int) int;
    fn cleg_rect(x int, y int, w int, h int, r int, g int, b int) int;
    fn cleg_roundrect(x int, y int, w int, h int, radius int, r int, g int, b int) int;
    fn cleg_text(x int, y int, size int, r int, g int, b int, text String, font String) int;
    fn cleg_frame(path String) int;
    fn cleg_screen_open(w int, h int, title String) int;
    fn cleg_screen_present() int;
    fn cleg_screen_close() int;
}

// ---------- QSS 风格 style 读取（纯 qk；旧键别名回退） ----------
space {
    fn st(style HashTable<String, String>, key String, fallback String) String {
        if (style.contains(key)) { return style.get(key); }
        if (key == "background-color" && style.contains("bg")) { return style.get("bg"); }
        if (key == "font-size" && style.contains("size")) { return style.get("size"); }
        if (key == "font-family" && style.contains("font")) { return style.get("font"); }
        return fallback;
    }
    fn num(style HashTable<String, String>, key String, fb int) int {
        if (style.contains(key)) { return style.get(key).toInt(); }
        if (key == "font-size" && style.contains("size")) { return style.get("size").toInt(); }
        return fb;
    }
    fn cr(style HashTable<String, String>, key String, idx int, fb int) int {
        v String = qss::st(style, key, "");
        if (v == "") { return fb; }
        parts List<String> = v.split(",");
        if (parts.size() > idx) { return parts[idx].toInt(); }
        return fb;
    }
} (qss);

// ---------- 自动重绘（纯 qk：tick 遍历节点列表逐个 render） ----------
fn tick(nodes List<ClegNode>) void {
    i int = 0;
    while (i < nodes.size()) {
        n ClegNode = nodes[i];
        n.render();
        i = i + 1;
    }
}

// ---------- 布局（Qt QBoxLayout 语义：按槽位重排节点 pos） ----------
space {
    fn vbox(items List<ClegNode>, x int, y int, w int, spacing int) void {
        cur int = y;
        i int = 0;
        while (i < items.size()) {
            n ClegNode = items[i];
            n.getStyle()["pos"] = x.toString() + "," + cur.toString();
            cur = cur + n.getH() + spacing;
            i = i + 1;
        }
    }
    fn hbox(items List<ClegNode>, x int, y int, spacing int) void {
        cur int = x;
        i int = 0;
        while (i < items.size()) {
            n ClegNode = items[i];
            n.getStyle()["pos"] = cur.toString() + "," + y.toString();
            cur = cur + n.getW() + spacing;
            i = i + 1;
        }
    }
    fn grid(items List<ClegNode>, x int, y int, cols int, cw int, ch int, spacing int) void {
        i int = 0;
        while (i < items.size()) {
            n ClegNode = items[i];
            gx int = x + (i % cols) * (cw + spacing);
            gy int = y + (i / cols) * (ch + spacing);
            n.getStyle()["pos"] = gx.toString() + "," + gy.toString();
            i = i + 1;
        }
    }
} (cleglayout);

// ---------- 信号（Qt signal 语义 v1：qksignal_emit 触发节点方法 onClicked 等） ----------
space {
    fn emit(node ClegNode, name String) void {
        qksignal_emit(node, name);
    }
    // emit 带参：onTextChanged(newText) / onValueChanged(value) / onCurrentIndexChanged(index) 等
    fn emitArgs(node ClegNode, name String, v int) void {
        qksignal_emit(node, name, v);
    }
    fn emitText(node ClegNode, name String, v String) void {
        qksignal_emit(node, name, v);
    }
} (clegsignal);



interface {
    dynamic fn render(self Self) void;
    dynamic fn setStyle(self Self, jsonText String) void;
    dynamic fn getStyle(self Self) HashTable<String, String>;
    dynamic fn getX(self Self) int;
    dynamic fn getY(self Self) int;
    dynamic fn getW(self Self) int;
    dynamic fn getH(self Self) int;
} ClegNode;

struct {
    style HashTable<String, String>;
    x int;
    y int;
    w int;
    h int;
} ClegMainWindow;

impl ClegMainWindow ClegNode {
    fn new() ClegMainWindow {
        s ClegMainWindow;
        s.style = HashTable::new();
        s.style["text"] = "MainWindow";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["font"] = "monospace";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        return s;
    }
    fn render(self) void {
        clegrt.cleg_clear(qss::cr(self.style, "background-color", 0, 30),
            qss::cr(self.style, "background-color", 1, 34),
            qss::cr(self.style, "background-color", 2, 46));
        clegrt.cleg_rect(self.getX() + 64, self.getY() + 48, 1152, 704, 38, 44, 60);
        clegrt.cleg_rect(self.getX() + 64, self.getY() + 48, 1152, 64, 52, 211, 235);
        clegrt.cleg_text(self.getX() + 96, self.getY() + 64, 6, 8, 28, 46, self.style.get("title"), qss::st(self.style, "font-family", "monospace"));
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        if (p.size() < 2) { return 0; }
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn setTitle(self, t String) void { self.style["title"] = t; }
    fn setStyle(self, jsonText String) void {
        obj HashTable<String, String> = json::loads(jsonText);
        ks List<String> = obj.keys();
        i int = 0;
        while (i < ks.size()) {
            k String = ks[i];
            self.style[k] = obj.get(k);
            i = i + 1;
        }
    }
} ClegMainWindow;

