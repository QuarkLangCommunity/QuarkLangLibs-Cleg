        if (!clegstyle::visible(self)) { return; }
        int tf = clegstyle::begin(self);
        clegstyle::paintBox(self);
        String st = clegstyle::stateOf(self);
        Rect c = clegstyle::contentRect(self);
        List<String> sections = clegstyle::getD(self, "items", st, "").split(";");
        int i = 0;
        while (i < sections.size()) {
            int sx = c.x + i * 120;
            clegstyle::paintTextD(self, sections[i], sx + 8, c.y, 112, c.h, "left", "middle");
            clegfx::blend(sx, c.y, 1, c.h, qss::mkColor(170, 178, 190, 255), 255, 0);
            i = i + 1;
