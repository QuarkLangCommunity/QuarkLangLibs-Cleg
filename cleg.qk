impl ClegDialogButtonBox ClegNode {
    fn new() ClegDialogButtonBox {
        s ClegDialogButtonBox;
        s.style = HashTable::new();
        s.style["text"] = "DialogButtonBox";
        s.style["color"] = "255,255,255";
        s.style["bg"] = "56,64,84";
        s.style["size"] = "4";
        s.style["pos"] = "0,0";
        s.style["items"] = "";
        s.style["tabs"] = "";
        s.style["menus"] = "";
        s.style["rows"] = "3";
        s.x = 0; s.y = 0; s.w = 220; s.h = 60;
        return s;
    }
    fn render(self) void {
        qkcleg_rect(self.getX(), self.getY(), self.w, 40, 34, 40, 54);
        menus List<String> = self.style.get("menus").split(";");
        i int = 0;
        while (i < menus.size()) { qkcleg_text(self.getX() + 12 + i * 120, self.getY() + 10, 4, 220, 225, 235, menus[i]); i = i + 1; }
    }
    fn getStyle(self) HashTable<String, String> { return self.style; }
    fn getX(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[0].toInt();
    }
    fn getY(self) int {
        p List<String> = self.style.get("pos").split(",");
        return p[1].toInt();
    }
    fn getW(self) int { return self.w; }
    fn getH(self) int { return self.h; }
    fn addButton(self, t String) void { self.style["items"] = self.style.get("items") + ";" + t; }
    fn setStyle(self, jsonText String) void {
        qkcleg_style_parse(self.style, jsonText);
    }
} ClegDialogButtonBox;

